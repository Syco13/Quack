{
  "name": "quack",
  "version": "0.1.0",
  "private": true,
  "author": "Syco",
  "description": "Auto-duck Spotify when you talk",
  "main": "dist/main/main.js",
  "scripts": {
    "postinstall": "electron-builder install-app-deps",
    "clean": "rimraf dist",
    "build": "npm run clean && tsc && cpx \"src/renderer/index.html\" dist/renderer && cpx \"src/renderer/styles.css\" dist/renderer && cpx \"assets/**/*\" dist/assets",
    "dev": "npm run build && electronmon .",
    "start": "npm run build && electron .",
    "rebuild": "electron-builder install-app-deps",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "@ricky0123/vad-node": "^0.0.3",
    "electron-store": "^10.0.0",
    "native-sound-mixer": "3.4.6-win",
    "naudiodon": "^2.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "canvas": "^3.2.3",
    "cpx": "^1.5.0",
    "electron": "^35.0.0",
    "electron-builder": "^26.0.12",
    "electronmon": "^2.0.3",
    "png-to-ico": "^3.0.1",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.3"
  },
  "build": {
    "appId": "com.duckit.app",
    "productName": "Quack",
    "icon": "assets/icon.png",
    "files": [
      "dist/**"
    ],
    "directories": {
      "buildResources": "build"
    },
    "win": {
      "icon": "assets/icon.png",
      "target": [
        "nsis"
      ]
    }
  }
}
